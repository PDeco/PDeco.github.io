{% if include.repository.repo %}
  {% assign repo_full = include.repository.repo %}
  {% assign repo_description = include.repository.description %}
  {% assign repo_language = include.repository.language %}
{% else %}
  {% assign repo_full = include.repository %}
  {% assign repo_description = nil %}
  {% assign repo_language = nil %}
{% endif %}

{% assign repo_url = repo_full | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign repo_title = repo_url.last %}
{% else %}
  {% assign repo_title = repo_full %}
{% endif %}

<div class="repo p-2 w-100">
  <a class="repo-card" href="https://github.com/{{ repo_full }}">
    <div class="repo-card-title">
      <i class="fa-solid fa-book-bookmark"></i>
      {{ repo_title }}
    </div>
    {% if repo_description %}
      <p class="repo-card-description">{{ repo_description }}</p>
    {% endif %}
    {% if repo_language %}
      <div class="repo-card-meta"><i class="fa-solid fa-code"></i> {{ repo_language }}</div>
    {% endif %}
  </a>
</div>
